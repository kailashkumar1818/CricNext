# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/cricbuzz_db
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cricbuzz_db

# Authentication
JWT_SECRET=cricbuzz_jwt_secret_key_secure_2026
JWT_EXPIRES_IN=7d

# Cricket External API (Optional - if left empty, server uses built-in live mock data provider)
CRICAPI_KEY=
RAPIDAPI_KEY=
RAPIDAPI_HOST=cricbuzz-cricket.p.rapidapi.com

# Cache Settings (in seconds)
LIVE_CACHE_TTL=10
NEWS_CACHE_TTL=300
SCHEDULE_CACHE_TTL=600
